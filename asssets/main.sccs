
---
---

@import "minima";

/* ==== 蔡叽的互联网小屋 ==== */

body {
  background: linear-gradient(
    135deg,
    #ffb6d9,
    #e6c7ff,
    #c9f4ff
  );
  font-family: Arial, sans-serif;
}

.site-title {
  color: #7c258e !important;
  font-weight: 900;
}

.page-content {
  background: rgba(255, 255, 255, 0.75);
  border-radius: 20px;
}

h1, h2, h3 {
  color: #e84393;
}

a {
  color: #8b35c9;
}
